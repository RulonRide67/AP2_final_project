# Application
APP_NAME=auth-service
APP_ENV=development
LOG_LEVEL=debug
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
HTTP_METRICS_HOST=0.0.0.0
HTTP_METRICS_PORT=9090

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=auth
POSTGRES_PASSWORD=auth_secret
POSTGRES_DB=auth_db
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=5
# Used by golang-migrate: make migrate-up
DATABASE_URL=postgres://auth:auth_secret@localhost:5432/auth_db?sslmode=disable

# Redis (refresh tokens, rate limiting)
REDIS_ADDR=localhost:6379
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAXMEMORY=256mb
REDIS_SESSION_TTL=24h

# NATS (domain events)
NATS_URL=nats://localhost:4222
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_SUBJECT_PREFIX=auth.events

# Public HTTP (links in emails open in browser — verify / reset forms)
HTTP_PUBLIC_HOST=localhost
HTTP_PUBLIC_PORT=8080

# SMTP — Gmail example (use App Password, not account password):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USE_TLS=false (STARTTLS on 587)
#   Create App Password: Google Account → Security → 2FA → App passwords
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@auth.local
SMTP_FROM_NAME=Auth Service
SMTP_USE_TLS=false

# Email links (defaults to http://HTTP_PUBLIC_HOST:HTTP_PUBLIC_PORT/...)
VERIFY_EMAIL_BASE_URL=http://localhost:8080/verify-email
RESET_PASSWORD_BASE_URL=http://localhost:8080/reset-password
VERIFICATION_TOKEN_TTL=24h
PASSWORD_RESET_TOKEN_TTL=1h

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=auth-service

# Prometheus / Grafana (used by docker-compose)
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
